{
  "name": "nanshan-heart-spirit-film",
  "version": "1.0.0",
  "private": true,
  "description": "永續小精靈大作戰：南山 HEART 綠色夥伴計畫 — 60 秒 Cinematic 4K 宣傳影片（Remotion）",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "still": "remotion still src/index.ts NanshanHeartFilm out/still.png",
    "render": "remotion render src/index.ts NanshanHeartFilm out/nanshan-heart-4k60.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --concurrency=50%",
    "render:prores": "remotion render src/index.ts NanshanHeartFilm out/nanshan-heart-4k60.mov --codec=prores --prores-profile=4444",
    "render:preview": "remotion render src/index.ts NanshanHeartFilm out/preview-1080p.mp4 --scale=0.5 --crf=20"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.532",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.532"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
